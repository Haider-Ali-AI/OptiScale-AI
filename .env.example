# OptiScale AI — environment variable NAMES only. Never commit real values.
# Core analytics, synthetic demo, XGBoost, optimizer and the local Big Data lab need NO keys.

# Next.js server-side proxy target for local development (not a secret).
API_ORIGIN=http://127.0.0.1:8000

# Backend workspace directory. Use a disposable folder for tests/demos.
# ADS_DATA_DIR=C:\path\to\optiscale-data

# Spark: a JDK 17/21/25 home. Auto-detected from ./.runtime/<jdk>/ by scripts/dev.mjs.
# JAVA_HOME=C:\path\to\jdk-17

# Optional NVIDIA explanations (server-side only; or save it from the AI assistant page).
# NVIDIA_API_KEY=

# Hosted single-owner mode only (set in the provider dashboard, never here):
# ADS_ACCESS_PASSWORD=   (>= 32 chars, username "owner"; required by BOTH Next.js and Python)
# ADS_HOSTED=1
# ADS_ALLOWED_ORIGINS=https://<your-project>.vercel.app
# ADS_DATABASE_URL= / POSTGRES_URL= / DATABASE_URL=   (private Neon Postgres for snapshots)
# Never use a NEXT_PUBLIC_ prefix for any secret.
